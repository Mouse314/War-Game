#pragma kernel CSMain
#pragma kernel PackVFXData

#include "Assets/Shaders/ParticleData.hlsl"

StructuredBuffer<ParticleData> _particlesDataRead;
RWStructuredBuffer<ParticleData> _particlesDataWrite;
RWStructuredBuffer<float4> _vfxPositionBuffer; // xyz = position, w = isAlive (0 or 1)
int size;

RWStructuredBuffer<int> _gameStats; // 0 = faction 0 alive count, 1 = faction 1 alive count

float deltaTime;
float time;

// Spatial Hashing
StructuredBuffer<uint2> _sortBuffer;
StructuredBuffer<uint2> _cellOffsetsBuffer;
float _Radius;
uint _TableSize;

// Render Texture
Texture2D<float4> _LandscapeTexture;
SamplerState sampler_LandscapeTexture;

// Mouse & keyboard input
float2 _mousePosition;
float3 _mouseDelta;
int _mouseButtonPressed;
int _isMouseClicked;
int _isShiftPressed;

// Simulation parameters
float _repulsionStrength = 10.0;
float _cohesionStrength = 0.1;
float _attackStrength;
float _centerOfMassStrength = 10.0;
bool _isPaused;

// Spawn
int _spawnIndex;

int2 GetCell(float3 pos)
{
    return int2(floor(pos.x / _Radius), floor(pos.z / _Radius));
}

uint HashCell(int2 cell)
{
    const uint p1 = 73856093;
    const uint p2 = 19349663;
    uint h = (uint(cell.x) * p1) ^ (uint(cell.y) * p2);
    return h % _TableSize;
}

[numthreads(4,1,4)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    int index = id.x * size + id.z;
    ParticleData particleData;

    if (index >= size * size) return;

    particleData = _particlesDataRead[index];

    // --- Spawn ---
    if (particleData.isAlive == 0 && _isShiftPressed == 1)
    {
        if (_isMouseClicked == 1 && index == _spawnIndex)
        {
            particleData.position = float3(_mousePosition.x, 0, _mousePosition.y);
            particleData.velocity = float3(0, 0, 0);
            particleData.color = float4(1, 1, 1, 1);
            particleData.isAlive = 1;
            particleData.fraction = _mouseButtonPressed; // 0 for left button, 1 for right button
            particleData.health = 1.0; // Reset health to 1.0 on spawn

            InterlockedAdd(_gameStats[particleData.fraction], 1); // Increment alive count for the faction
        }
        else
        {
            _particlesDataWrite[index] = particleData;
            return;
        }
    }

    // --- Adjust position ---
    // Mouse impact
    if (_isMouseClicked == 1 && _isShiftPressed == 0)
    {
        float3 mousePos = float3(_mousePosition.x, 0, _mousePosition.y);
        float3 direction = mousePos - particleData.position;
        float distance = length(direction);

        if (distance > 0.0001 && distance < 1.0 && _mouseButtonPressed == particleData.fraction && length(_mouseDelta) > 0.0001)
        {
            float force = 60.0;
            particleData.velocity += (1.0 - distance) * normalize(_mouseDelta) * -force * deltaTime;
        }
    }

    float nearestEnemyDistance = 1000000.0;
    int nearestEnemyIndex = -1;

    // Calculate both faction centers from the same read-only snapshot.
    // float3 ownFactionCenter = float3(0, 0, 0);
    // float3 enemyFactionCenter = float3(0, 0, 0);
    // int ownFactionCount = 0;
    // int enemyFactionCount = 0;
    // for (int otherIndex = 0; otherIndex < size * size; otherIndex++)
    // {
    //     ParticleData otherParticle = _particlesDataRead[otherIndex];
    //     if (otherParticle.isAlive == 0) continue;

    //     if (otherParticle.fraction == particleData.fraction)
    //     {
    //         ownFactionCenter += otherParticle.position;
    //         ownFactionCount++;
    //     }
    //     else
    //     {
    //         enemyFactionCenter += otherParticle.position;
    //         enemyFactionCount++;
    //     }
    // }

    // if (ownFactionCount > 0) ownFactionCenter /= ownFactionCount;
    // if (enemyFactionCount > 0) enemyFactionCenter /= enemyFactionCount;

    // --- Repulsion & cohesion & attack ---
    // Repulsion - from all neighbours, Cohesion - to same fraction neighbours
    float3 enemyFactionCenter = float3(0, 0, 0);
    int enemyFactionCount = 0;
    int2 myCell = GetCell(particleData.position);
    for (int ox = -1; ox <= 1; ox++)
    {
        for (int oz = -1; oz <= 1; oz++)
        {
            int2 cell = myCell + int2(ox, oz);
            uint2 bounds = _cellOffsetsBuffer[HashCell(cell)];

            for (uint j = bounds.x; j < bounds.y; j++)
            {
                uint otherIndex = _sortBuffer[j].y;
                if (otherIndex == (uint)index) continue;
                ParticleData otherParticle = _particlesDataRead[otherIndex];
                if (otherParticle.isAlive == 0) continue;
                float3 direction = particleData.position - otherParticle.position;
                float distance = length(direction.xz);

                // Repulsion 
                if (distance < _Radius / 2.0) {
                    float force = (_Radius / 2.0 - distance) * _repulsionStrength;
                    if (distance > 0.0001)
                    {
                        particleData.velocity += normalize(direction) * force * deltaTime;
                    }
                } 
                // Cohesion
                else if (distance < _Radius && otherParticle.fraction == particleData.fraction) {
                    float force = (_Radius - distance) * _cohesionStrength;
                    particleData.velocity -= normalize(direction) * force * deltaTime;
                }
                // Find the nearest enemy in the local neighbourhood.
                if (distance < nearestEnemyDistance && otherParticle.fraction != particleData.fraction) {
                    nearestEnemyDistance = distance;
                    nearestEnemyIndex = (int)otherIndex;
                }
                // Take damage (only not in pause mode)
                if (distance < _Radius && otherParticle.fraction != particleData.fraction && _isPaused == 0) {
                    enemyFactionCenter += otherParticle.position;
                    enemyFactionCount++;
                    float attackForce = pow(_Radius - distance, 2) * _attackStrength;
                    particleData.health -= attackForce * deltaTime;
                }
            }
        }
    }

    // Move toward the opposing faction center when it exists.
    if (enemyFactionCount > 0 && _isPaused == 0)
    {
        enemyFactionCenter /= enemyFactionCount;
        float3 directionToEnemy = enemyFactionCenter - particleData.position;
        float distanceToEnemy = length(directionToEnemy.xz);
        if (distanceToEnemy > 0.0001)
        {
            particleData.velocity += normalize(directionToEnemy) * _centerOfMassStrength * deltaTime;
        }
    }

    // Keep the simulation on the xOz plane.
    particleData.velocity.y = 0.0;
    particleData.velocity *= 0.95;

    // --- Ajust position ---
    float wallLimit = 6.0;
    particleData.position += particleData.velocity * deltaTime;
    particleData.position.y = 0.0;

    float wallRestitution = 0.7;

    if (particleData.position.x < -wallLimit)
    {
        particleData.position.x = -wallLimit;
        particleData.velocity.x = abs(particleData.velocity.x) * wallRestitution;
    }
    else if (particleData.position.x > wallLimit)
    {
        particleData.position.x = wallLimit;
        particleData.velocity.x = -abs(particleData.velocity.x) * wallRestitution;
    }

    if (particleData.position.z < -wallLimit)
    {
        particleData.position.z = -wallLimit;
        particleData.velocity.z = abs(particleData.velocity.z) * wallRestitution;
    }
    else if (particleData.position.z > wallLimit)
    {
        particleData.position.z = wallLimit;
        particleData.velocity.z = -abs(particleData.velocity.z) * wallRestitution;
    }

    // --- Death check ---
    if (particleData.isAlive != 0 && particleData.health <= 0.0)
    {
        particleData.isAlive = 0;
        particleData.health = 1.0; // Reset health for future spawns
        InterlockedAdd(_gameStats[particleData.fraction], -1); // Decrement alive count for the faction
    }

    // --- Ajust color ---
    // float textureHorizontalScale = 2560.0 / 1440.0;
    // float3 rotatedPos = float3(particleData.position.z, particleData.position.y, -particleData.position.x);
    // rotatedPos.x /= textureHorizontalScale;
    // float2 uv = saturate((rotatedPos.xz) / 1.85 / 10.0 + 0.5);
    // float4 colorFromTexture = _LandscapeTexture.SampleLevel(sampler_LandscapeTexture, uv, 0.0);
    // particleData.color = colorFromTexture * 2.0;

    // --- Update particle data ---
    _particlesDataWrite[index] = particleData;
}

[numthreads(4,1,4)]
void PackVFXData (uint3 id : SV_DispatchThreadID)
{
    int index = id.x * size + id.z;
    if (index >= size * size) return;

    ParticleData particleData = _particlesDataRead[index];
    _vfxPositionBuffer[index] = float4(particleData.position, particleData.isAlive != 0 ? 1.0 : 0.0);
}
